# Client build configuration (youngie/ React Native app)
#
# Everything here is prefixed EXPO_PUBLIC_, which means it is INLINED INTO THE
# SHIPPED BUNDLE at build time. Never put a real secret in this file: anything
# here can be read by anyone who unzips the app.
#
# IMPORTANT: EAS cloud builds do NOT read this file from your machine. Set these
# as EAS environment variables before building, or the release build silently
# falls back to http://10.0.2.2:5001 (the Android emulator loopback) and the app
# cannot reach any server.
#
#   eas env:create --environment=production --name EXPO_PUBLIC_API_URL --value https://api.example.com --visibility plaintext
#
# Repeat for every variable below. Verify with:
#   eas env:list --environment=production

# --- Backend ---
# Trailing /api is required; SOCKET_URL is derived by stripping it.
EXPO_PUBLIC_API_URL=https://api.example.com/api

# Comma-separated origins used as Socket.IO failover endpoints, without /api.
EXPO_PUBLIC_SERVER_ENDPOINTS=https://api.example.com

# --- Supabase ---
# The anon key is designed to be public (row level security is the real
# boundary). Do NOT put EXPO_PUBLIC_SUPABASE_SERVICE_ROLE_KEY here.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- TURN (WebRTC relay) ---
# Required for calls to connect when the two devices are behind symmetric NAT.
# Get your own credentials from your TURN provider; a shared demo key is
# rate-limited and will fail under real traffic.
# Release builds log a warning and fall back to STUN-only if these are missing.
EXPO_PUBLIC_TURN_USERNAME=
EXPO_PUBLIC_TURN_CREDENTIAL=
# Optional: full override, JSON array of RTCIceServer objects.
# EXPO_PUBLIC_TURN_SERVERS=[{"urls":"turn:turn.example.com:3478","username":"u","credential":"c"}]

# --- AdMob ---
# These are ad UNIT ids, not the App ID from app.json.
# Leave blank to keep a format disabled.
EXPO_PUBLIC_ADMOB_BANNER_UNIT_ID=
EXPO_PUBLIC_ADMOB_INTERSTITIAL_UNIT_ID=
EXPO_PUBLIC_ADMOB_REWARDED_UNIT_ID=
EXPO_PUBLIC_ADMOB_APP_OPEN_UNIT_ID=
EXPO_PUBLIC_ADMOB_NATIVE_UNIT_ID=
# Leave true until the app blocks under-13 users. This is a legal/compliance
# switch set by Google Play, not a performance one.
EXPO_PUBLIC_ADMOB_CHILD_DIRECTED=true

# --- Optional external services ---
# EXPO_PUBLIC_EXTERNAL_APIS={"geocoding":"https://nominatim.openstreetmap.org"}

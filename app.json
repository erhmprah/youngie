{
  "expo": {
    "name": "youngie",
    "slug": "youngie",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/youngie_icon.png",
    "scheme": "youngie",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.erhmprah.youngie",
      "notification": {
        "icon": "youngie_icon",
        "color": "#FF231F7C"
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "This app needs access to camera for video chat functionality.",
        "NSMicrophoneUsageDescription": "This app needs access to microphone for video chat functionality.",
        "NSLocalNetworkUsageDescription": "This app needs access to local network for peer-to-peer video chat.",
        "NSCalendarsUsageDescription": "This app needs access to your calendar to create community events.",
        "NSLocationWhenInUseUsageDescription": "This app uses your location to show nearby content.",
        "NSPhotoLibraryUsageDescription": "This app needs access to your photo library to select and share media.",
        "NSPhotoLibraryAddUsageDescription": "This app needs access to save photos to your library.",
        "NSBluetoothPeripheralUsageDescription": "This app uses Bluetooth to connect to audio devices during calls.",
        "UIBackgroundModes": ["remote-notification", "voip"],
        "CFBundleURLTypes": [
          {
            "CFBundleTypeRole": "Editor",
            "CFBundleURLName": "com.erhmprah.youngie",
            "CFBundleURLSchemes": [
              "youngie",
              "exp+youngie",
              "com.googleusercontent.apps.274460413616-cqu0cvkqhajj72hleui5l2raovj59ssd"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "com.erhmprah.youngie",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/youngie_icon.png",
        "backgroundColor": "#E6F4FE"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.WAKE_LOCK",
        "android.permission.READ_PHONE_STATE",
        "android.permission.CALL_PHONE",
        "android.permission.ANSWER_PHONE_CALLS",
        "android.permission.READ_CALL_LOG",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "youngie"
            },
            {
              "scheme": "exp+youngie"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/youngie_icon.png"
    },
    "assetBundlePatterns": [
      "assets/sounds/**"
    ],
    "plugins": [
      "expo-router",
      "expo-dev-client",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/youngie_icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "buildToolsVersion": "35.0.0"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "googleServicesFile": "./google-services.json"
        }
      ],
      "./withCallKeep",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "721a225e-d748-4c8c-bc60-79da0e1db590"
      }
    },
    "owner": "erhmprah"
  }
}
